# JEV Sentinel Environment
SENTINEL_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
# For local dev without Postgres, use:
# DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
JEV_API_KEY=
JEV_API_URL=https://api.jev.example/v1
JEV_ENABLED=false
SENTINEL_MODE=gated
SENTINEL_MAX_RETRIES=3
SENTINEL_MAX_DIFF_SIZE=5242880
SENTINEL_MAX_FILE_SIZE=1048576
DOCKER_ENABLED=true
SANDBOX_IMAGE=python:3.12-slim
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production
